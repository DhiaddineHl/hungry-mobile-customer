# Copy to `.env` and replace <dev-machine-lan-ip> with the LAN IP of the machine running
# the backend. `localhost` is the phone itself on a physical device, so it never works.
# EXPO_PUBLIC_* values are embedded in the app bundle in plaintext — no secrets here.

# --- Keycloak -------------------------------------------------------------------------
# Reached DIRECTLY, not through the gateway: the gateway only routes to hungry-app, so
# /realms/... is not one of its routes. Published on :8081 by the backend compose file.
EXPO_PUBLIC_KEYCLOAK_URL=http://<dev-machine-lan-ip>:8081
EXPO_PUBLIC_KEYCLOAK_REALM=hungry
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=hungry-customer-app

# --- Hungry backend -------------------------------------------------------------------
# The jfwk-gateway edge (:8082) — NOT hungry-app (:8080). Since the gateway was added,
# hungry-app publishes no host port; the gateway is the only reachable application port
# and it validates the Keycloak access token before proxying (hungry-app re-validates it).
# Only `POST /customers` (self-registration) passes without a token.
EXPO_PUBLIC_API_URL=http://<dev-machine-lan-ip>:8082

# --- Google Maps ----------------------------------------------------------------------
# Injected into the native config by app.config.ts; changing it needs a new native build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
